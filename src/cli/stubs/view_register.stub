{% extends "layouts/app.blade.rs" %}

{% block title %}Register - Lumina Framework{% endblock %}

{% block content %}
<div class="min-h-[75vh] flex items-center justify-center px-4 relative">
    <div class="max-w-xs w-full bg-cardBg border border-borderBg rounded-lg p-5 shadow-lg relative z-10 text-xs">
        <div class="text-center mb-4">
            <h2 class="text-sm font-bold text-white code-font">Create Account</h2>
            <p class="text-slate-400 mt-0.5 text-[10px]">Create your credentials to get started</p>
        </div>

        {{ alert_flash() }}

        <form action="/auth/register" method="POST" class="space-y-3">
            <input type="hidden" name="csrf_token" value="{{ csrf_token }}">

            <div>
                <label class="block font-semibold text-slate-300 mb-1">Full Name</label>
                <input type="text" name="name" class="w-full bg-darkBg border border-borderBg rounded px-2.5 py-1.5 text-white focus:outline-none focus:border-primary transition text-[11px]" 
                    placeholder="e.g. Slamet Sugandi" value="{{ old.name | default(value="") }}" required>
                {{ form_error(field="name") }}
            </div>

            <div>
                <label class="block font-semibold text-slate-300 mb-1">Email Address</label>
                <input type="email" name="email" class="w-full bg-darkBg border border-borderBg rounded px-2.5 py-1.5 text-white focus:outline-none focus:border-primary transition text-[11px]" 
                    placeholder="name@example.com" value="{{ old.email | default(value="") }}" required>
                {{ form_error(field="email") }}
            </div>

            <div>
                <label class="block font-semibold text-slate-300 mb-1">Password</label>
                <input type="password" name="password" class="w-full bg-darkBg border border-borderBg rounded px-2.5 py-1.5 text-white focus:outline-none focus:border-primary transition text-[11px]" 
                    placeholder="Create password" required>
                {{ form_error(field="password") }}
            </div>

            <div>
                <label class="block font-semibold text-slate-300 mb-1">Confirm Password</label>
                <input type="password" name="password_confirmation" class="w-full bg-darkBg border border-borderBg rounded px-2.5 py-1.5 text-white focus:outline-none focus:border-primary transition text-[11px]" 
                    placeholder="Repeat password" required>
            </div>

            <button type="submit" class="w-full bg-success hover:bg-emerald-500 text-darkBg font-bold py-1.5 rounded transition mt-2">
                Create Account
            </button>
        </form>

        <p class="text-center text-[10px] text-slate-400 mt-4">
            Already have an account? <a href="/auth/login" class="text-success font-bold hover:underline">Login</a>
        </p>
    </div>
</div>
{% endblock %}
