# ============================================
# Lumina Framework - .gitignore
# ============================================

# --- Rust Build Output ---
# Folder ini berisi hasil kompilasi, JANGAN dicommit
/target/
Cargo.lock

# --- Environment Variables ---
# File .env berisi secret/config lokal, JANGAN dicommit
.env

# --- OS Files ---
.DS_Store
Thumbs.db
desktop.ini

# --- Editor / IDE ---
# .vscode/ (Shared settings are allowed)
.vscode/*   
.idea/
*.swp
*.swo
*~

# --- Logs ---
storage/logs/
.lumina_tinker_history
*.log

# --- Temporary Files ---
*.tmp
*.bak

# --- Cache ---
storage/cache/*
!storage/cache/.gitkeep

# --- Databases ---
*.db
*.sqlite
*.exe

# --- Temporary Artifacts ---
.github/*.md

skill_for_creates/*
docs/*
DOCUMENTATION.md
CEAT_SHEET.md
skill_for_create*.md

# --- Local Test Project ---
/apptodolist/
