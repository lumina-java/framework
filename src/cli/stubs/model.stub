use serde::{Serialize, Deserialize};
use sqlx::FromRow;
use async_trait::async_trait;
use crate::database::model::Model;
use crate::database::connection::DatabasePool;

#[derive(Debug, Serialize, Deserialize, FromRow)]
pub struct {{name}} {
    pub id: i64,
    // Add fields here
    pub created_at: Option<chrono::NaiveDateTime>,
    pub updated_at: Option<chrono::NaiveDateTime>,
    pub deleted_at: Option<chrono::NaiveDateTime>,
}

#[async_trait]
impl Model for {{name}} {
    async fn find(db: &DatabasePool, id: i64) -> Option<Self> {
        sqlx::query_as::<_, Self>("SELECT * FROM {{table_name}} WHERE id = ? AND deleted_at IS NULL")
            .bind(id)
            .fetch_optional(db.get_pool())
            .await
            .ok()
            .flatten()
    }

    async fn all(db: &DatabasePool) -> Vec<Self> {
        sqlx::query_as::<_, Self>("SELECT * FROM {{table_name}} WHERE deleted_at IS NULL")
            .fetch_all(db.get_pool())
            .await
            .unwrap_or_default()
    }

    async fn save(&self, db: &DatabasePool) -> bool {
        // Implement insert or update logic here
        true
    }

    async fn delete(&self, db: &DatabasePool) -> bool {
        sqlx::query("UPDATE {{table_name}} SET deleted_at = CURRENT_TIMESTAMP WHERE id = ?")
            .bind(self.id)
            .execute(db.get_pool())
            .await
            .is_ok()
    }
}
