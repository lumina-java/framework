# ============================================
# Lumina Framework - .gitignore
# ============================================

# --- Rust Build Output ---
# Folder ini berisi hasil kompilasi, JANGAN dicommit
/target/
Cargo.lock

# --- Environment Variables ---
# File .env berisi secret/config lokal, JANGAN dicommit
.env

# --- OS Files ---
.DS_Store
Thumbs.db
desktop.ini

# --- Editor / IDE ---
.vscode/
.idea/
*.swp
*.swo
*~

# --- Logs ---
storage/logs/
.lumina_tinker_history
*.log

# --- Temporary Files ---
*.tmp
*.bak

# --- Cache ---
storage/cache/*
!storage/cache/.gitkeep

# --- Databases ---
*.db
*.sqlite
*.exe

# --- Storage uploads ---
storage/app/public/uploads/*
!storage/app/public/uploads/.gitkeep

# --- Local Test Project ---
/apptodolist/

# --- Internal Work History & Draft Skills (Never commit to GitHub) ---
/docs/history_pekerjaan/
/docs/planing_pekerjaan/
/skill_for_creates/
skill_for_createse.md
CRUD_TEST_REPORT.md
