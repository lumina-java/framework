{
  "name": "lumina-vscode",
  "displayName": "Lumina Framework Templates",
  "description": "Syntax highlighting and snippets for Lumina Framework templates (Blade-like + Tera).",
  "version": "0.1.0",
  "publisher": "lumina",
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Programming Languages",
    "Snippets"
  ],
  "contributes": {
    "languages": [
      {
        "id": "lumina",
        "aliases": ["Lumina", "lumina"],
        "extensions": [".blade.rs", ".html"],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "lumina",
        "scopeName": "text.html.lumina",
        "path": "./syntaxes/lumina.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "lumina",
        "path": "./snippets/lumina.json"
      },
      {
        "language": "html",
        "path": "./snippets/lumina.json"
      }
    ]
  }
}
