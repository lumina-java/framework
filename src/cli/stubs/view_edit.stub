{% block content %}
<div class="max-w-7xl mx-auto px-4 py-6 text-xs sm:text-sm">
    <div class="mb-4">
        <a href="/{{ snake_name }}s" class="text-[10px] text-primary hover:underline flex items-center gap-1 mb-2">
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path></svg>
            Back to List
