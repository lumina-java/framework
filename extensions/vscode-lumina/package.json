{
  "name": "lumina-vscode",
  "displayName": "Lumina Framework (IDE Support & Blade Snippets)",
  "description": "Official Lumina Framework tooling: Eloquent models, beautiful controllers, RESTful routing, and Blade template syntax highlighting.",
  "version": "0.2.0",
  "publisher": "lumina",
  "author": "Slamet Sugandi <packercyber@gmail.com>",
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Programming Languages",
    "Snippets"
  ],
  "contributes": {
    "languages": [
      {
        "id": "lumina",
        "aliases": ["Lumina", "lumina"],
        "extensions": [".blade.rs", ".html"],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "lumina",
        "scopeName": "text.html.lumina",
        "path": "./syntaxes/lumina.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "lumina",
        "path": "./snippets/lumina.json"
      },
      {
        "language": "html",
        "path": "./snippets/lumina.json"
      },
      {
        "language": "rust",
        "path": "./snippets/rust.json"
      }
    ]
  }
}
