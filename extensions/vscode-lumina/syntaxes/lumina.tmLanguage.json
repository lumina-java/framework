{
  "scopeName": "text.html.lumina",
  "name": "Lumina",
  "patterns": [
    { "include": "#blade-tags" },
    { "include": "#tera-tags" },
    { "include": "text.html.basic" }
  ],
  "repository": {
    "blade-tags": {
      "patterns": [
        {
          "name": "keyword.control.lumina",
          "match": "@(if|elseif|else|endif|foreach|as|endforeach|extends|section|endsection|yield|csrf|include|guest|auth|stack|push|endpush)\\b"
        },
        {
          "name": "variable.other.lumina",
          "match": "\\$\\w+"
        }
      ]
    },
    "tera-tags": {
      "patterns": [
        {
          "name": "entity.name.tag.tera",
          "begin": "\\{%",
          "end": "%\\}",
          "patterns": [
            {
              "name": "keyword.control.tera",
              "match": "\\b(if|else|elif|endif|for|in|endfor|filter|endfilter|macro|endmacro|import|set|include|extends|block|endblock)\\b"
            }
          ]
        },
        {
          "name": "variable.other.tera",
          "begin": "\\{\\{",
          "end": "\\}\\}",
          "patterns": [
            {
              "name": "variable.parameter.tera",
              "match": "\\b\\w+\\b"
            }
          ]
        },
        {
          "name": "comment.block.tera",
          "begin": "\\{#",
          "end": "#\\}"
        }
      ]
    }
  }
}
