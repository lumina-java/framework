use axum::response::IntoResponse;
use crate::core::response::Redirect;
use crate::core::view::View;
use serde_json::json;
use crate::core::request::Request;
use lumina_macros::lumina_form;
use crate::app::models::{{snake_name}}::{{name}};
use crate::database::model::Model;

#[lumina_form]
pub struct {{name}}Form {
    #[rule("required|min:3")]
    pub name: String,
    // Tambahkan field lainnya di sini
    pub csrf_token: String,
}

pub struct {{name}}Controller;

impl {{name}}Controller {
    /// GET /{{snake_name}}s
    pub async fn index(req: Request) -> impl IntoResponse {
        let items = {{name}}::query(req.db()).get().await.unwrap_or_default();

        req.view("{{snake_name}}.index")
            .with("items", &items)
            .render(&req)
            .await
    }

    /// GET /{{snake_name}}s/create
    pub async fn create(req: Request) -> impl IntoResponse {
        req.view("{{snake_name}}.create")
            .with("csrf_token", req.token.authenticity_token().unwrap())
            .render(&req)
            .await
    }

    /// POST /{{snake_name}}s
    pub async fn store(
        req: Request,
        crate::core::validation::ValidatedForm(form): crate::core::validation::ValidatedForm<{{name}}Form>,
    ) -> impl IntoResponse {
        if req.token.verify(&form.csrf_token).is_err() {
            return req.redirect("/{{snake_name}}s/create").with_error("Invalid CSRF Token").go(&req).await
        }

        let result = sqlx::query("INSERT INTO {{table_name}} (name) VALUES (?)")
            .bind(&form.name)
            .execute(&req.db().pool).await;

        match result {
            Ok(_) => req.redirect("/{{snake_name}}s").with_success("Data berhasil disimpan!").go(&req).await,
            Err(e) => req.redirect("/{{snake_name}}s/create")
                .with_input(json!({"name": form.name}))
                .with_error(&format!("Gagal menyimpan data: {}", e))
                .go(&req).await
        }
    }

    /// GET /{{snake_name}}s/:id/edit
    pub async fn edit(req: Request, axum::extract::Path(id): axum::extract::Path<i64>) -> impl IntoResponse {
        let item = {{name}}::find(req.db(), id).await.expect("Data tidak ditemukan");

        req.view("{{snake_name}}.edit")
            .with("item", &item)
            .with("csrf_token", req.token.authenticity_token().unwrap())
            .render(&req)
            .await
    }

    /// POST /{{snake_name}}s/:id/update
    pub async fn update(
        req: Request,
        axum::extract::Path(id): axum::extract::Path<i64>,
        crate::core::validation::ValidatedForm(form): crate::core::validation::ValidatedForm<{{name}}Form>,
    ) -> impl IntoResponse {
        if req.token.verify(&form.csrf_token).is_err() {
            return req.redirect(&format!("/{{snake_name}}s/{}/edit", id)).with_error("Invalid CSRF Token").go(&req).await
        }

        let result = sqlx::query("UPDATE {{table_name}} SET name = ? WHERE id = ?")
            .bind(&form.name)
            .bind(id)
            .execute(&req.db().pool).await;

        match result {
            Ok(_) => req.redirect("/{{snake_name}}s").with_success("Data berhasil diupdate!").go(&req).await,
            Err(e) => req.redirect(&format!("/{{snake_name}}s/{}/edit", id))
                .with_input(json!({"name": form.name}))
                .with_error(&format!("Gagal update data: {}", e))
                .go(&req).await
        }
    }

    /// POST /{{snake_name}}s/:id/delete
    pub async fn delete(req: Request, axum::extract::Path(id): axum::extract::Path<i64>) -> impl IntoResponse {
        let _ = sqlx::query("DELETE FROM {{table_name}} WHERE id = ?")
            .bind(id)
            .execute(&req.db().pool).await;

        req.redirect("/{{snake_name}}s").with_success("Data berhasil dihapus!").go(&req).await
    }
}
