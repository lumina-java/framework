{% extends "layout.html" %}

{% block content %}
<div class="page-title-box d-flex align-items-center justify-content-between">
    <h4 class="mb-0">Tambah {{ name }}</h4>
    <div class="page-title-right">
        <a href="/{{ snake_name }}s" class="btn btn-danger" hx-boost="true">
            <i class="ri-arrow-left-line align-bottom me-1"></i> Batal (Esc)
        </a>
    </div>
</div>

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card mt-3">
            <div class="card-body">
                <form action="/{{ snake_name }}s" method="POST" hx-boost="true">
                    <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
                    
                    <div class="mb-3">
                        <label for="name" class="form-label">Nama {{ name }}</label>
                        <input type="text" class="form-control {% if errors.name %}is-invalid{% endif %}" 
                               id="name" name="name" value="{{ old.name }}" autofocus required>
                        {% if errors.name %}
                        <div class="invalid-feedback">{{ errors.name }}</div>
                        {% endif %}
                    </div>

                    <div class="text-end">
                        <button type="submit" class="btn btn-success">
                            Simpan Data (F10)
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
{% endblock %}
